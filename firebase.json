{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "archi-front",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/stripe/**", "function": "stripeApi" },
      { "source": "/api/workspace/**", "function": "workspaceApi" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
